{
  "name": "mcp-rest-bridge-admin-ui",
  "version": "1.1.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "vite",
    "types:openapi": "openapi-typescript ../src/openapi.yaml -o src/types/openapi.generated.ts",
    "build": "vue-tsc -b && vite build",
    "typecheck": "bun run types:openapi && vue-tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:i18n": "bun scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/space-grotesk": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.6",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "js-yaml@4": "^4.3.2",
    "nanoid@3": "^3.3.18",
    "postcss-selector-parser@7": "^7.1.6",
    "postcss@8": "^8.5.23",
    "source-map-js@1": "^1.2.2",
    "undici@8": "^8.10.2"
  }
}
